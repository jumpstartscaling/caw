---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Campaigns">
  <h2 class="text-xl font-bold mb-4">Campaign Masters</h2>
  <button onclick="showAddForm()" class="mb-4">+ Add Campaign</button>
  <div id="add-form" class="hidden mb-4 p-4 bg-gray-900 rounded border border-gray-800">
    <input id="name" placeholder="Name" class="mr-2 mb-2" />
    <input id="site_id" placeholder="Site ID" class="mr-2 mb-2 w-24" type="number" />
    <button onclick="addCampaign()">Save</button>
    <button onclick="document.getElementById('add-form').classList.add('hidden')" class="ml-2 bg-gray-600">Cancel</button>
  </div>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/campaign-masters?limit=200');
        const rows = await r.json();
        if (!r.ok) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error</p>`; return; }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table><thead><tr><th>ID</th><th>Name</th><th>Site ID</th><th>Status</th><th></th></tr></thead><tbody>${arr.map(c => `<tr><td>${c.id}</td><td>${c.name ?? '-'}</td><td>${c.site_id ?? '-'}</td><td>${c.status ?? '-'}</td><td><button class="danger" onclick="del(${c.id})">Delete</button></td></tr>`).join('')}</tbody></table>` : '<p class="text-gray-400">No campaigns yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`; }
    }
    function showAddForm() { document.getElementById('add-form').classList.remove('hidden'); }
    async function addCampaign() {
      const sid = document.getElementById('site_id').value;
      await fetch(base() + '/api/campaign-masters', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: document.getElementById('name').value, site_id: sid ? parseInt(sid) : null }) });
      load(); document.getElementById('add-form').classList.add('hidden');
    }
    async function del(id) { if (confirm('Delete?')) { await fetch(base() + `/api/campaign-masters/${id}`, { method: 'DELETE' }); load(); } }
    load();
  </script>
</AdminLayout>
