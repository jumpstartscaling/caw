---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Avatar Intelligence">
  <p class="text-gray-400 mb-4">Avatar personas. <a href="/jumpstart/admin/content/avatars" class="text-gold">Manage avatars</a>.</p>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/avatar-intelligence?limit=200');
        const rows = await r.json();
        if (!r.ok) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error</p>`; return; }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table><thead><tr><th>ID</th><th>Avatar Key</th><th>Base Name</th><th>Status</th></tr></thead><tbody>${arr.map(a => `<tr><td>${a.id}</td><td>${a.avatar_key ?? '-'}</td><td>${a.base_name ?? '-'}</td><td>${a.status ?? '-'}</td></tr>`).join('')}</tbody></table>` : '<p class="text-gray-400">No avatars yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`; }
    }
    load();
  </script>
</AdminLayout>
