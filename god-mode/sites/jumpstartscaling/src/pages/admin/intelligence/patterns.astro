---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Cartesian Patterns">
  <h2 class="text-xl font-bold mb-4">Patterns</h2>
  <button onclick="showAddForm()" class="mb-4">+ Add Pattern</button>
  <div id="add-form" class="hidden mb-4 p-4 bg-gray-900 rounded border border-gray-800">
    <input id="name" placeholder="Name" class="mr-2 mb-2" />
    <textarea id="pattern_logic" placeholder="Pattern logic" class="mb-2 w-full" rows="2"></textarea>
    <button onclick="addPattern()">Save</button>
    <button onclick="document.getElementById('add-form').classList.add('hidden')" class="ml-2 bg-gray-600">Cancel</button>
  </div>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/cartesian-patterns?limit=200');
        const rows = await r.json();
        if (!r.ok) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error</p>`; return; }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table><thead><tr><th>ID</th><th>Name</th><th>Status</th><th></th></tr></thead><tbody>${arr.map(p => `<tr><td>${p.id}</td><td>${p.name ?? '-'}</td><td>${p.status ?? '-'}</td><td><button class="danger" onclick="del(${p.id})">Delete</button></td></tr>`).join('')}</tbody></table>` : '<p class="text-gray-400">No patterns yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`; }
    }
    function showAddForm() { document.getElementById('add-form').classList.remove('hidden'); }
    async function addPattern() {
      await fetch(base() + '/api/cartesian-patterns', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: document.getElementById('name').value, pattern_logic: document.getElementById('pattern_logic').value }) });
      load(); document.getElementById('add-form').classList.add('hidden');
    }
    async function del(id) { if (confirm('Delete?')) { await fetch(base() + `/api/cartesian-patterns/${id}`, { method: 'DELETE' }); load(); } }
    load();
  </script>
</AdminLayout>
