---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Spintax">
  <h2 class="text-xl font-bold mb-4">Spintax Dictionaries</h2>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/spintax-dictionaries?limit=200');
        const rows = await r.json();
        if (!r.ok) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error</p>`; return; }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table><thead><tr><th>ID</th><th>Category</th></tr></thead><tbody>${arr.map(s => `<tr><td>${s.id}</td><td>${s.category ?? '-'}</td></tr>`).join('')}</tbody></table>` : '<p class="text-gray-400">No spintax yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`; }
    }
    load();
  </script>
</AdminLayout>
