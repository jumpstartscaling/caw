---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Geo Intelligence">
  <p class="text-gray-400 mb-4">Geographic clusters. <a href="/jumpstart/admin/content/geo_clusters" class="text-gold">Manage geo clusters</a>.</p>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/geo-intelligence?limit=200');
        const rows = await r.json();
        if (!r.ok) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error</p>`; return; }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table><thead><tr><th>ID</th><th>Cluster</th><th>City</th><th>State</th><th>Population</th></tr></thead><tbody>${arr.map(g => `<tr><td>${g.id}</td><td>${g.cluster_key ?? '-'}</td><td>${g.city ?? '-'}</td><td>${g.state ?? '-'}</td><td>${g.population ?? '-'}</td></tr>`).join('')}</tbody></table>` : '<p class="text-gray-400">No geo entries yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`; }
    }
    load();
  </script>
</AdminLayout>
