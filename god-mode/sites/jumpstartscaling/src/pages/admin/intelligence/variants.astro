---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Avatar Variants">
  <h2 class="text-xl font-bold mb-4">Avatar Variants</h2>
  <button onclick="showAddForm()" class="mb-4">+ Add Variant</button>
  <div id="add-form" class="hidden mb-4 p-4 bg-gray-900 rounded border border-gray-800">
    <input id="avatar_key" placeholder="Avatar Key" class="mr-2 mb-2" />
    <input id="name" placeholder="Name" class="mr-2 mb-2" />
    <button onclick="addVariant()">Save</button>
    <button onclick="document.getElementById('add-form').classList.add('hidden')" class="ml-2 bg-gray-600">Cancel</button>
  </div>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/avatar-variants?limit=200');
        const rows = await r.json();
        if (!r.ok) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error</p>`; return; }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table><thead><tr><th>ID</th><th>Avatar Key</th><th>Name</th><th>Status</th><th></th></tr></thead><tbody>${arr.map(v => `<tr><td>${v.id}</td><td>${v.avatar_key ?? '-'}</td><td>${v.name ?? '-'}</td><td>${v.status ?? '-'}</td><td><button class="danger" onclick="del(${v.id})">Delete</button></td></tr>`).join('')}</tbody></table>` : '<p class="text-gray-400">No variants yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`; }
    }
    function showAddForm() { document.getElementById('add-form').classList.remove('hidden'); }
    async function addVariant() {
      await fetch(base() + '/api/avatar-variants', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ avatar_key: document.getElementById('avatar_key').value, name: document.getElementById('name').value }) });
      load(); document.getElementById('add-form').classList.add('hidden');
    }
    async function del(id) { if (confirm('Delete?')) { await fetch(base() + `/api/avatar-variants/${id}`, { method: 'DELETE' }); load(); } }
    load();
  </script>
</AdminLayout>
