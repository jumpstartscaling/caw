---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Articles">
  <h2 class="text-xl font-bold mb-4">Article Workbench</h2>
  <p class="text-gray-400 mb-4">Generated articles. <a href="/jumpstart/admin/seo/articles" class="text-gold">View as list</a>.</p>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/generated-articles?limit=200');
        const rows = await r.json();
        if (!r.ok) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error</p>`; return; }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table><thead><tr><th>ID</th><th>Title</th><th>Slug</th><th>Status</th></tr></thead><tbody>${arr.map(a => `<tr><td>${a.id}</td><td>${(a.title || '').slice(0, 50)}...</td><td>${a.slug ?? '-'}</td><td>${a.status ?? '-'}</td></tr>`).join('')}</tbody></table>` : '<p class="text-gray-400">No articles yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`; }
    }
    load();
  </script>
</AdminLayout>
