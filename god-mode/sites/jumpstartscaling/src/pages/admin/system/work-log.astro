---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Work Log">
  <h2 class="text-xl font-bold mb-4">Activity Log</h2>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/work-log?limit=200');
        const rows = await r.json();
        if (!r.ok) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error</p>`; return; }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table><thead><tr><th>ID</th><th>Action</th><th>Entity</th><th>Level</th><th>Time</th></tr></thead><tbody>${arr.map(w => `<tr><td>${w.id}</td><td>${w.action ?? '-'}</td><td>${w.entity_type ?? '-'} #${w.entity_id ?? ''}</td><td>${w.level ?? '-'}</td><td>${w.timestamp ?? '-'}</td></tr>`).join('')}</tbody></table>` : '<p class="text-gray-400">No work log entries yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`; }
    }
    load();
  </script>
</AdminLayout>
