---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="System">
  <h2 class="text-xl font-bold mb-4">System Administration</h2>
  <div id="status" class="mb-4"><p class="text-gray-400">Loading...</p></div>
  <p class="text-gray-400">
    <a href="/jumpstart/admin/status" class="text-gold">Status</a> · 
    <a href="/jumpstart/admin/debug" class="text-gold">Debug</a> · 
    <a href="/jumpstart/admin/system/work-log" class="text-gold">Work Log</a>
  </p>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/health');
        const d = await r.json();
        document.getElementById('status').innerHTML = `<p class="text-green-400">API: ${d.status ?? 'ok'}</p>`;
      } catch (e) {
        document.getElementById('status').innerHTML = `<p class="text-red-400">API unreachable: ${e.message}</p>`;
      }
    }
    load();
  </script>
</AdminLayout>
