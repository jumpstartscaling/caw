---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="pSEO Services">
  <h2 class="text-xl font-bold mb-4">pSEO Services</h2>
  <button onclick="showAddForm()" class="mb-4">+ Add Service</button>
  <div id="add-form" class="hidden mb-4 p-4 bg-gray-900 rounded border border-gray-800">
    <input id="service_type" placeholder="Service type" class="mr-2 mb-2 w-64" />
    <input id="sub_niche" placeholder="Sub niche" class="mr-2 mb-2 w-40" />
    <button onclick="addService()">Save</button>
    <button onclick="document.getElementById('add-form').classList.add('hidden')" class="ml-2 bg-gray-600">Cancel</button>
  </div>
  <div id="services-table"><p class="text-gray-400">Loading...</p></div>
  <script>
    async function load() {
      try {
        const r = await fetch((window.__ADMIN_API_BASE__ || '') + '/api/pseo-services');
        const data = await r.json();
        const rows = Array.isArray(data) ? data : [];
        if (!r.ok) {
          const msg = (typeof data?.detail === 'string' ? data.detail : JSON.stringify(data?.detail || data)) || r.statusText || `HTTP ${r.status}`;
          document.getElementById('services-table').innerHTML = `<p class="text-red-400">API error: ${msg}</p>`;
          return;
        }
        const html = `
          <table>
            <thead><tr><th>ID</th><th>Service Type</th><th>Sub Niche</th><th>Slug</th><th></th></tr></thead>
            <tbody>
              ${rows.map(s => `
                <tr><td>${s.id}</td><td>${s.service_type}</td><td>${s.sub_niche ?? ''}</td><td>${s.slug ?? ''}</td><td><button class="danger" onclick="del(${s.id})">Delete</button></td></tr>
              `).join('')}
            </tbody>
          </table>
        `;
        document.getElementById('services-table').innerHTML = rows.length ? html : '<p class="text-gray-400">No services.</p>';
      } catch (e) {
        document.getElementById('services-table').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`;
      }
    }
    function showAddForm() { document.getElementById('add-form').classList.remove('hidden'); }
    async function addService() {
      const body = { service_type: document.getElementById('service_type').value, sub_niche: document.getElementById('sub_niche').value || null };
      await fetch((window.__ADMIN_API_BASE__ || '') + '/api/pseo-services', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      load();
      document.getElementById('add-form').classList.add('hidden');
    }
    async function del(id) { if (confirm('Delete?')) { await fetch((window.__ADMIN_API_BASE__ || '') + `/api/pseo-services/${id}`, { method: 'DELETE' }); load(); } }
    load();
  </script>
</AdminLayout>
