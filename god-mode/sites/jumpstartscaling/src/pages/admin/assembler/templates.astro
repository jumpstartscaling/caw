---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Templates">
  <h2 class="text-xl font-bold mb-4">Template List</h2>
  <p class="text-gray-400 mb-4">Content assembly templates. <a href="/jumpstart/admin/collections/content-fragments" class="text-gold">Manage fragments</a>.</p>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/content-fragments?limit=100');
        const rows = await r.json();
        if (!r.ok) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error</p>`; return; }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table><thead><tr><th>ID</th><th>Type</th><th>Text</th></tr></thead><tbody>${arr.map(f => `<tr><td>${f.id}</td><td>${f.fragment_type ?? '-'}</td><td>${(f.fragment_text || '').slice(0, 60)}...</td></tr>`).join('')}</tbody></table>` : '<p class="text-gray-400">No fragments. Add via Collections.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`; }
    }
    load();
  </script>
</AdminLayout>
