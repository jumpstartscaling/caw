---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Scheduler">
  <h2 class="text-xl font-bold mb-4">Scheduled Tasks</h2>
  <button onclick="showAddForm()" class="mb-4">+ Schedule Task</button>
  <div id="add-form" class="hidden mb-4 p-4 bg-gray-900 rounded border border-gray-800">
    <input id="job_type" placeholder="Job Type" class="mr-2 mb-2" />
    <input id="run_at" placeholder="Run at (ISO datetime)" class="mr-2 mb-2 w-64" />
    <button onclick="addTask()">Save</button>
    <button onclick="document.getElementById('add-form').classList.add('hidden')" class="ml-2 bg-gray-600">Cancel</button>
  </div>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/scheduled-tasks?limit=200');
        const rows = await r.json();
        if (!r.ok) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error</p>`; return; }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table><thead><tr><th>ID</th><th>Job Type</th><th>Run At</th><th>Status</th><th></th></tr></thead><tbody>${arr.map(t => `<tr><td>${t.id}</td><td>${t.job_type ?? '-'}</td><td>${t.run_at ?? '-'}</td><td>${t.status ?? '-'}</td><td><button class="danger" onclick="del(${t.id})">Delete</button></td></tr>`).join('')}</tbody></table>` : '<p class="text-gray-400">No scheduled tasks yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`; }
    }
    function showAddForm() { document.getElementById('add-form').classList.remove('hidden'); }
    async function addTask() {
      await fetch(base() + '/api/scheduled-tasks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ job_type: document.getElementById('job_type').value, run_at: document.getElementById('run_at').value }) });
      load(); document.getElementById('add-form').classList.add('hidden');
    }
    async function del(id) { if (confirm('Delete?')) { await fetch(base() + `/api/scheduled-tasks/${id}`, { method: 'DELETE' }); load(); } }
    load();
  </script>
</AdminLayout>
