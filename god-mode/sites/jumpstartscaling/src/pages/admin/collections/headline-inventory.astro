---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Headline Inventory">
  <h2 class="text-xl font-bold mb-4">Headline Inventory</h2>
  <button onclick="showAddForm()" class="mb-4">+ Add Headline</button>
  <div id="add-form" class="hidden mb-4 p-4 bg-gray-900 rounded border border-gray-800">
    <input id="headline_text" placeholder="Headline text" class="mr-2 mb-2 w-96" />
    <input id="campaign_id" placeholder="Campaign ID (optional)" class="mr-2 mb-2 w-32" type="number" />
    <button onclick="addHeadline()">Save</button>
    <button onclick="document.getElementById('add-form').classList.add('hidden')" class="ml-2 bg-gray-600">Cancel</button>
  </div>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/headline-inventory?limit=200');
        const rows = await r.json();
        if (!r.ok) {
          document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error: ${r.status}</p>`;
          return;
        }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table>
          <thead><tr><th>ID</th><th>Campaign</th><th>Headline</th><th>Used</th><th></th></tr></thead>
          <tbody>${arr.map(h => `<tr><td>${h.id}</td><td>${h.campaign_id ?? '-'}</td><td>${(h.headline_text || '').slice(0, 60)}${(h.headline_text || '').length > 60 ? '...' : ''}</td><td>${h.is_used ? 'Yes' : 'No'}</td><td><button class="danger" onclick="del(${h.id})">Delete</button></td></tr>`).join('')}</tbody>
        </table>` : '<p class="text-gray-400">No headlines yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) {
        document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`;
      }
    }
    function showAddForm() { document.getElementById('add-form').classList.remove('hidden'); }
    async function addHeadline() {
      const cid = document.getElementById('campaign_id').value;
      await fetch(base() + '/api/headline-inventory', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ headline_text: document.getElementById('headline_text').value, campaign_id: cid ? parseInt(cid) : null }) });
      load();
      document.getElementById('add-form').classList.add('hidden');
    }
    async function del(id) { if (confirm('Delete?')) { await fetch(base() + `/api/headline-inventory/${id}`, { method: 'DELETE' }); load(); } }
    load();
  </script>
</AdminLayout>
