---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Offer Blocks">
  <h2 class="text-xl font-bold mb-4">Offer Blocks</h2>
  <button onclick="showAddForm()" class="mb-4">+ Add Offer Block</button>
  <div id="add-form" class="hidden mb-4 p-4 bg-gray-900 rounded border border-gray-800">
    <input id="name" placeholder="Name" class="mr-2 mb-2" />
    <input id="block_type" placeholder="Block Type" class="mr-2 mb-2" />
    <button onclick="addBlock()">Save</button>
    <button onclick="document.getElementById('add-form').classList.add('hidden')" class="ml-2 bg-gray-600">Cancel</button>
  </div>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/offer-blocks?limit=200');
        const rows = await r.json();
        if (!r.ok) {
          document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error: ${r.status}</p>`;
          return;
        }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table>
          <thead><tr><th>ID</th><th>Name</th><th>Block Type</th><th>Status</th><th></th></tr></thead>
          <tbody>${arr.map(b => `<tr><td>${b.id}</td><td>${b.name ?? '-'}</td><td>${b.block_type ?? '-'}</td><td>${b.status ?? '-'}</td><td><button class="danger" onclick="del(${b.id})">Delete</button></td></tr>`).join('')}</tbody>
        </table>` : '<p class="text-gray-400">No offer blocks yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) {
        document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`;
      }
    }
    function showAddForm() { document.getElementById('add-form').classList.remove('hidden'); }
    async function addBlock() {
      await fetch(base() + '/api/offer-blocks', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: document.getElementById('name').value, block_type: document.getElementById('block_type').value }) });
      load();
      document.getElementById('add-form').classList.add('hidden');
    }
    async function del(id) { if (confirm('Delete?')) { await fetch(base() + `/api/offer-blocks/${id}`, { method: 'DELETE' }); load(); } }
    load();
  </script>
</AdminLayout>
