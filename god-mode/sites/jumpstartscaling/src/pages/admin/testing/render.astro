---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Block Render">
  <h2 class="text-xl font-bold mb-4">Block Preview</h2>
  <p class="text-gray-400">Client-side block preview. Enter HTML or text below.</p>
  <textarea id="input" class="w-full h-32 bg-gray-900 border border-gray-800 rounded p-2 mt-4" placeholder="Enter content to preview..."></textarea>
  <button onclick="render()" class="mt-2">Render</button>
  <div id="preview" class="mt-4 p-4 bg-gray-900 rounded border border-gray-800 min-h-[100px]"></div>
  <script>
    function render() {
      const html = document.getElementById('input').value;
      document.getElementById('preview').innerHTML = html || '<em>Empty</em>';
    }
  </script>
</AdminLayout>
