---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---
<AdminLayout title="Sites">
  <h2 class="text-xl font-bold mb-4">Sites</h2>
  <p class="text-gray-400 mb-4">
    <a href="/jumpstart/admin/sites/jumpstart" class="text-gold mr-4">Jumpstart Wizard</a>
    <a href="/jumpstart/admin/sites/import" class="text-gold">WP Import</a>
  </p>
  <div id="table-wrap"><p class="text-gray-400">Loading...</p></div>
  <script>
    const base = () => window.__ADMIN_API_BASE__ || '';
    async function load() {
      try {
        const r = await fetch(base() + '/api/sites?limit=200');
        const rows = await r.json();
        if (!r.ok) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">API error</p>`; return; }
        const arr = Array.isArray(rows) ? rows : [];
        const html = arr.length ? `<table><thead><tr><th>ID</th><th>Name</th><th>URL</th><th>Status</th></tr></thead><tbody>${arr.map(s => `<tr><td>${s.id}</td><td>${s.name ?? '-'}</td><td>${s.url ?? '-'}</td><td>${s.status ?? '-'}</td></tr>`).join('')}</tbody></table>` : '<p class="text-gray-400">No sites yet.</p>';
        document.getElementById('table-wrap').innerHTML = html;
      } catch (e) { document.getElementById('table-wrap').innerHTML = `<p class="text-red-400">Error: ${e.message}</p>`; }
    }
    load();
  </script>
</AdminLayout>
