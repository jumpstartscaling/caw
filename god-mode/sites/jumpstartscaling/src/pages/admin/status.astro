---
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Status">
  <h2 class="text-xl font-bold mb-4">API Status</h2>
  <div id="status"><p class="text-gray-400">Checking...</p></div>
  <script>
    async function load() {
      try {
        const r = await fetch((window.__ADMIN_API_BASE__ || '') + '/api/health');
        const d = await r.json();
        document.getElementById('status').innerHTML = `
          <p class="text-green-400">API is active.</p>
          <pre class="mt-4 p-4 bg-gray-900 rounded">${JSON.stringify(d, null, 2)}</pre>
        `;
      } catch (e) {
        document.getElementById('status').innerHTML = `<p class="text-red-400">API unreachable: ${e.message}</p>`;
      }
    }
    load();
  </script>
</AdminLayout>
