# God Mode API - Environment Template
# Copy to .env and fill in real values. Never commit .env.

# Database (PostgreSQL)
DATABASE_URL=postgresql://god_user:YOUR_PASSWORD@localhost:5432/god_mode
# Or individual vars:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=god_mode
# DB_USER=god_user
# DB_PASSWORD=your_password

# Server
PORT=8200
HOST=0.0.0.0

# Admin: API key for programmatic access (n8n, scripts). Use ?key= or X-Admin-Key header.
ADMIN_KEY=spark

# Admin: session-based login for human access (browser)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<bcrypt-hash or plaintext for dev>
SESSION_SECRET=<generate-secure-random e.g. openssl rand -hex 32>

# Optional: disable request logging to api_logs
# LOG_REQUESTS=false
