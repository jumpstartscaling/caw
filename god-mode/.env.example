# God Mode - Environment Template
# Copy to .env or .env.local and fill in values. Never commit with real secrets.

# --- Coolify API (required for seed-via-coolify, configure-coolify, deploy) ---
# Get from Coolify → Keys & Tokens → API tokens → Create
# COOLIFY_TOKEN=your_token_here

# --- Router (god-mode container) ---
PORT=8100
SITES_BASE_PATH=/app
ADMIN_KEY=<generate-secure-random>
GOD_MODE_API_URL=https://api.jumpstartscaling.com

# For Astro build (pSEO pages) - set during Docker build
# PUBLIC_GOD_MODE_API_URL=https://api.jumpstartscaling.com
# PUBLIC_N8N_WEBHOOK=https://n8n.jumpstartscaling.com/webhook/...

# --- Local Docker (docker-compose) ---
# When using docker-compose, Postgres is included. Default DATABASE_URL:
# postgresql://godmode:godmode_local@postgres:5432/god_mode
# Override password: DB_PASSWORD=your_secure_password

# --- God Mode API (god-mode-api container) ---
# Coolify: DATABASE_URL=postgresql://USER:PASSWORD@COOLIFY_DB_CONTAINER:5432/god_mode
# god-mode-api and Postgres must be in same Coolify network (same project).
# ADMIN_KEY=<same-as-router>
# AUTO_SEED_CHRISAMAYA=true   # Default: seed chrisamaya.work on every startup
# LOG_REQUESTS=true

# --- Payload CMS (optional) ---
# PUBLIC_PAYLOAD_URL=https://cms.jumpstartscaling.com
